pub fn keyword(size:i32,first:i32,second:i32,third:i32,keys:&Keywords)->i32{
 if size>11{return 2;}
 let at=(first%107+size*20)%127;let tag=keys.tag[at];
 if tag/64!=size{return 2;}if keys.first[at]!=first{return 2;}
 if keys.second[at]!=second{return 2;}if keys.third[at]!=third{return 2;}return tag%64;
}
