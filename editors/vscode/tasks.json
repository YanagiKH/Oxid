{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Oxid: check saved typed-preview entry",
      "type": "process",
      "command": "oxid",
      "args": ["check", "--edition=typed-preview", "--message-format=text", "--", "${file}"],
      "options": {"cwd": "${workspaceFolder}"},
      "runOptions": {"runOn": "default"},
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "problemMatcher": {
        "owner": "oxid-typed-check",
        "source": "Oxid typed-preview",
        "severity": "error",
        "fileLocation": ["autodetect", "${workspaceFolder}"],
        "pattern": [
          {"regexp": "^error\\[(E[0-9]+)\\] (\\([^\\r\\n]+\\): [^\\r\\n]*)\\r?$", "code": 1, "message": 2},
          {"regexp": "^  --> ([^\\r\\n]+):([1-9][0-9]*):[1-9][0-9]*\\r?$", "file": 1, "line": 2}
        ]
      }
    },
    {
      "label": "Oxid: check saved typed-preview formatting",
      "type": "process",
      "command": "oxid",
      "args": ["fmt", "--edition=typed-preview", "--check", "--", "${file}"],
      "options": {"cwd": "${workspaceFolder}"},
      "runOptions": {"runOn": "default"},
      "presentation": {"reveal": "always", "panel": "dedicated"},
      "problemMatcher": []
    }
  ]
}
