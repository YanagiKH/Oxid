+    let before = fingerprint(source, &parse(source));
+    let formatted = format_source(source).unwrap();
+    let mut output = SourceMap::new();
+    output.add("unrelated.ox".into(), "".into());
+    let id = output.add("byte-formatted.ox".into(), formatted);
