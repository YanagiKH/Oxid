+            let previous = &module[..position];
+            let success = previous.rfind("_bounds_ok:\n").unwrap();
+            let branch = previous[..success].rfind("_in_range, label").unwrap();
+            let signed = previous[..branch]
+                .rfind("_nonnegative = icmp sge i32")
