+        (
+            Limits {
+                owner_width: exact.owner_width - 1,
+                ..exact
+            },
+            "owner width",
+        ),
+        (
+            Limits {
+                bytes: total - 1,
+                ..exact
+            },
+            "aggregate storage bytes",
+        ),
+        (
+            Limits {
+                live_bytes: live - 1,
+                ..exact
+            },
+            "live storage bytes",
+        ),
+    ] {
+        let denied = case.observe(NativeControl {
