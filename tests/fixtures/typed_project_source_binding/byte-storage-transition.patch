+#[test]
+fn byte_storage_formatter_preserves_array_only_types_and_source_origins() {
+    let text = "// 雪\r\nfn byte(x:i32)->u8{return x.to_u8_checked();}fn f(a:& /*A*/ [u8],b:&mut [u8;0001])->[u8;0]{let c:[u8;0]=([]);b[0]=byte(255);a.len();return c;}";
