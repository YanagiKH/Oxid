+        .collect();
+    let mut statements = vec![
+        fixture::assign(0, Rvalue::I32(0), at(1)),
+        fixture::instruction(OwnedInstruction::StorageLive(OwnerPlaceId(0)), at(2)),
+        fixture::instruction(
