+        ("pub fn main()->i32{return 1;}", SyntaxFlavor::ProjectSyntax),
+        ("struct R {pub n:i32}", SyntaxFlavor::ProjectSyntax),
+        (
+            "use crate::f; fn f()->(){return;}",
