+        assert_eq!(project.usage().modules, 1);
+        assert_eq!(project.usage().probes, 0);
+        assert!(project.canonical_root.is_none());
+        let source = project.sources().get(SourceFileId(0));
+        assert_eq!(source.text(), text);
+        assert!(project
