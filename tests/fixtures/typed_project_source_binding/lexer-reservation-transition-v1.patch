+        fn checked_named_admission(parts: &[usize], ceiling: usize) -> Option<usize> {
+            parts
+                .iter()
+                .try_fold(0usize, |sum, part| sum.checked_add(*part))
+                .filter(|sum| *sum <= ceiling)
