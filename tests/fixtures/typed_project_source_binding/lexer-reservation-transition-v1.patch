+                        + error.secondary.capacity() * size_of::<(Span, String)>()
+                        + error
+                            .secondary
+                            .iter()
+                            .map(|(_, text)| text.capacity())
+                            .sum::<usize>()
+                        + error.notes.capacity() * size_of::<String>()
+                        + error.notes.iter().map(String::capacity).sum::<usize>()
+                })
+        }
