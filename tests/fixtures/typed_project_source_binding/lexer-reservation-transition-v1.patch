+        None,
+        TokenKind,
+        TokenStart,
+        TokenEnd,
+        TokenFile,
+        TokenCount,
+        DiagnosticCode,
+        DiagnosticStage,
+        DiagnosticMessage,
+        DiagnosticPrimary,
+        DiagnosticSecondary,
+        DiagnosticNotes,
+        Outcome,
+    }
