+#[cfg(test)]
+mod lexer_reservation_caller_tests {
+    use super::*;
+    use lexer::{Kind, Token};
+
+    const INPUT: &str = "fn main()->(){return;}";
+    const COMMENTS: &str = "/**//**//**//**/";
+    const MALFORMED: &str = ";/*";
+    const ZERO_CREDIT: &str = " ";
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    enum Callback {
+        Begin,
+        Observe,
+        ComparisonStarted,
+        ComparisonFinished(bool),
+        Selected,
+    }
+    #[derive(Clone, Copy, Debug)]
+    enum Association {
+        Valid,
+        Identity,
+        File,
+        Length,
+    }
+    #[derive(Clone, Copy, Debug)]
