+    fs::write(fixture.0.join("main.ox"), &formatted).unwrap();
+    let project = fixture.load();
+    assert_eq!(checked(&project).unwrap().run().unwrap(), Scalar::I32(7));
+    assert_eq!(
+        format::format_source(project.sources().get(SourceFileId(0))).unwrap(),
+        formatted
+    );
+}
