+fn before(module: &str, needle: &str, insertion: &str) -> String {
+    assert_eq!(
+        module.matches(needle).count(),
+        1,
+        "unique mutation site: {needle}"
+    );
+    module.replacen(needle, &format!("{insertion}{needle}"), 1)
+}
