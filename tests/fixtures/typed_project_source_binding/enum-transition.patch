+type ImportSnapshot = (
+    bool,
+    Option<NominalId>,
+    Option<DefId>,
+    Vec<NominalAliasObservation>,
+    Vec<SeenObservation>,
+);
+fn nominal_snapshots(work: &WorkMeter) -> Vec<ImportSnapshot> {
+    work.observations
+        .borrow()
+        .iter()
+        .filter_map(|event| {
+            if let Observation::NominalImport {
+                committed,
+                ty,
+                value,
+                aliases,
+                seen,
+                ..
+            } = event
+            {
+                Some((*committed, *ty, *value, aliases.clone(), seen.clone()))
+            } else {
+                None
+            }
+        })
+        .collect()
+}
