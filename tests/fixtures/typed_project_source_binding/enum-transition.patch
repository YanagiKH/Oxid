+            }
+            1 => raw.functions[0].matches[1].arms[0].dispatch = BlockId(1),
+            2 => raw.functions[0].matches[1].arms[0].entry = BlockId(3),
+            3 => {
+                if let OwnedInstruction::ConsumeVariant { match_id, .. } =
+                    &mut raw.functions[0].blocks[6].statements[0].kind
