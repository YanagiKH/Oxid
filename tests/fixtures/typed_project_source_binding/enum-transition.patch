+#[test]
+fn enum_formatter_independent_fingerprint_covers_qualified_values_and_match_origins() {
+    let text = "enum E{I(i32),Z}fn f(e:E,r:&R,s:&R)->(){crate::m::f(true,&*r);crate::m::g(&*r);crate::m::h(&*s);match e{E::I(v)=>{v;},E::Z=>{},}}";
