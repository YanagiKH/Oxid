+fn parse_enum_fingerprint(source: &SourceFile) -> Program {
+    parser::parse_enum_candidate_counted(
+        source,
+        lexer::lex(source).unwrap(),
+        SourceMode::ProjectCandidate,
+        parser::MAX_NODES,
+        &mut crate::frontend::project::budget::Allocator::default(),
+        &mut Default::default(),
+    )
+    .unwrap()
+    .0
+}
