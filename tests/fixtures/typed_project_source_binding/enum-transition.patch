+    assert!(matches!(error.kind, OwnedFailureKind::Resource(_)));
+    assert_ne!(
+        error.kind,
+        OwnedFailureKind::Resource("injected allocation failure")
+    );
+    let excessive = fixture(&[None; 257], &(0..257).collect::<Vec<_>>(), 0, s(0));
+    assert!(probe(&excessive, &sources).is_err());
+}
