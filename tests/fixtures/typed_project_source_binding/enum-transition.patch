+fn origin() -> Span {
+    Span {
+        file: SourceFileId(0),
+        start: 0,
+        end: 1,
+    }
+}
+fn one() -> TypeCounts {
+    TypeCounts {
+        functions: 1,
+        bindings: 1,
+        expressions: 1,
+        blocks: 1,
+        statements: 1,
+        borrow_arguments: 1,
+        type_frames: 1,
+        call_arguments: 1,
+        calls: 1,
