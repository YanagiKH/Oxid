+                    source: OwnerPlaceId(0),
+                    span,
+                    arms: vec![MatchArm {
+                        variant: VariantId {
+                            enumeration: EnumId(0),
+                            index: 0,
+                        },
+                        dispatch: BlockId(0),
+                        entry: BlockId(1),
+                    }],
+                }],
+                entry: BlockId(0),
+                blocks: vec![OwnedBlock {
+                    merge: None,
+                    span,
+                    statements: vec![
+                        OwnedStatement {
+                            span,
+                            diagnostic_origins: Some(DiagnosticOrigins {
+                                primary: span,
+                                cause: span,
+                            }),
+                            kind: OwnedInstruction::ConstructEnum {
