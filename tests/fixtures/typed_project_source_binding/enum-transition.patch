+            }
+            for (k, (label, width)) in typed_kinds.iter().copied().enumerate() {
+                let rows = suffix.iter().filter(|row| row.kind == label);
+                assert_eq!(
+                    rows.clone().count(),
+                    case.typed_requests[k],
+                    "{} {label}",
