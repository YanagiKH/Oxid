+                            },
+                        },
+                        OwnedStatement {
+                            span,
+                            diagnostic_origins: Some(DiagnosticOrigins {
+                                primary: span,
+                                cause: span,
+                            }),
+                            kind: OwnedInstruction::ConsumeVariant {
+                                match_id: MatchId(0),
+                                arm: 0,
+                                destination: None,
+                            },
+                        },
+                    ],
+                    terminator: Some(OwnedTerminator {
+                        span,
+                        diagnostic_origins: Some(DiagnosticOrigins {
