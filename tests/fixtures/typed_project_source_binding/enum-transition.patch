+#[test]
+fn c3a_inventory_reconciliation_uses_real_reserves_and_returns_fixed_payload_totals() {
+    let plan = scalar_plan();
+    let at = at();
+    let mut allocator = Allocator::default();
+    allocator.observer_trace_bound(13).unwrap();
