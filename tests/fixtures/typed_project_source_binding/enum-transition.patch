+        |index| {
+            let sources = index.sources();
+            let (key, module) = index.function(DefId(0)).unwrap();
+            let function = &sources.ast(module).unwrap().functions[key.index];
+            let left = function.params[0].name;
+            let right = function.params[1].name;
+            for limit in [7, 8, 9] {
