+fn confirmed(result: Result<Infallible, Rejected>) -> Vec<Diagnostic> {
+    match result {
+        Err(Rejected::Confirmed(errors)) => errors,
+        other => panic!("expected confirmed source diagnostics: {other:?}"),
+    }
