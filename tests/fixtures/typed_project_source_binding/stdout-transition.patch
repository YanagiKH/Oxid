+pub(super) fn forwarded_program() -> (SourceMap, RawOwnedProgram, hir::DefId) {
+    let (sources, raw, entry) = super::builtin_input_fixtures::forwarded_program(
+        super::builtin_input_fixtures::Observation::Status,
