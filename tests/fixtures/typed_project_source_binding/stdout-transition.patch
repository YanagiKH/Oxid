+            (failure.diagnostics[0].code, failure.diagnostics[0].stage),
+            ("E0005", "source"),
+        );
+    });
+    #[cfg(target_os = "linux")]
+    with_each_project(
+        &[("main.ox", ROOT), ("child.ox", CHILD)],
+        |index, sources| {
