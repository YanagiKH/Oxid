+            };
+            for admission in [
+                SourceAdmission::Executable,
+                SourceAdmission::ObserveArrayTypes,
+                SourceAdmission::ObserveEnumTypes,
+                SourceAdmission::EnumPipeline,
+                SourceAdmission::ObserveArrayPipeline,
