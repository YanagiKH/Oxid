+    ("use std::io::ReadStatus;", BuiltinSet::ReadStatus, 1, 0),
+    ("use std::io::read_stdin;", BuiltinSet::ReadStdin, 1, 1),
+    ("use std::io::WriteStatus;", BuiltinSet::WriteStatus, 1, 0),
+    ("use std::io::write_stdout;", BuiltinSet::WriteStdout, 1, 1),
