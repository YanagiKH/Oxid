+                raw.functions[output.0].span.start,
+                CHILD.find("write_stdout").unwrap()
+            );
+            assert_eq!(raw.functions[0].result, ValueTy::Scalar(hir::Ty::I32));
+            assert!(raw.functions[0].blocks.iter().all(|block| block
