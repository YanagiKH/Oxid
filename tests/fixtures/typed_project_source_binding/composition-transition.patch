+            continue;
+        }
+        state[root] = 1;
+        stack.push((root, 0usize));
+        while let Some(&(id, next)) = stack.last() {
+            if next < field_count(id) {
+                stack.last_mut().unwrap().1 += 1;
+                if let ValueTy::Owned(AggregateTy::Record(child)) = field_type(id, next)? {
