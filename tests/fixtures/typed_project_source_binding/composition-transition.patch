+#[test]
+fn record_composition_index_store_evaluates_rhs_before_index() {
+    Project::new(
+        "struct R{a:[i32;1]} fn index(p:&mut R)->i32{p.a[0]=99;return 0;} \
+fn main()->i32{let mut r=R{a:[7]};r.a[index(&mut r)]=r.a[0];return r.a[0];}",
+    )
+    .run("7\n");
+}
