+                .map(|id| {
+                    let child = if reverse {
+                        id.checked_sub(1)
+                    } else if id + 1 < length {
+                        Some(id + 1)
+                    } else {
+                        None
+                    };
+                    match child {
+                        Some(child) => nested(id, &[child], span),
+                        None => record(id, &[hir::Ty::I32], span),
+                    }
+                })
+                .collect();
+            let result = Declarations::check(&raw, &sources);
+            if length == 64 {
+                assert!(result.is_ok());
+            } else {
+                assert!(matches!(
+                    result,
+                    Err(DeclarationError::ResourceLimit("record containment depth"))
+                ));
+            }
+        }
+    }
+}
