+            );
+            assert!(
+                peak >= token.len() as isize,
+                "public control must detect a source-sized diagnostic"
+            );
+        }
+        println!(
+            "nonstarter candidate={candidate} allocation_calls={calls} retained={live} peak={peak}"
+        );
+    }
