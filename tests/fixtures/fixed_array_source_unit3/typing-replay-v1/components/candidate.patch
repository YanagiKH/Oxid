+    }
+}
+struct OptU(Option<usize>);
+impl fmt::Display for OptU {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self.0 {
+            Some(n) => write!(f, "{n}"),
