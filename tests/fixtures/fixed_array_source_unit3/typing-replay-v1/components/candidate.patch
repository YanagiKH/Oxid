+            Some(v) => write!(f, "{}", V(v, self.1, self.2)),
+            None => f.write_str("null"),
+        }
+    }
+}
+struct Ids<'a>(&'a [ExprId]);
+impl fmt::Display for Ids<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
