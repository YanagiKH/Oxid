+#[cfg(not(target_os = "linux"))]
+#[test]
+fn private_child_discovery_rejects_unqualified_hosts_before_child_io() {
+    let fixture = Fixture::new(&[("app.ox", "mod missing; fn main()->i32{return 0;}")]);
+    assert!(!fixture.0.join("missing.ox").exists());
+    let failure = ProjectSources::load_project_candidate(
+        fixture.0.join("app.ox").to_str().unwrap(),
+        ProjectLimits::default(),
+    )
+    .unwrap_err();
+    assert_eq!(failure.diagnostics.len(), 1);
+    assert_eq!(failure.diagnostics[0].code, "E0005");
+    assert_eq!(failure.diagnostics[0].stage, "source");
+    assert_eq!(
+        failure.diagnostics[0].message,
+        "module source policy is not qualified on this host"
+    );
+    assert_eq!(failure.usage.probes, 0);
+    assert_eq!(failure.usage.directory_entries, 0);
+}
