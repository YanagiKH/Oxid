+//! Independent exhaustive raw owned span-address registry.
+use super::*;
+use super::super::unit3_raw_scalar::{declaration,merge,span,statement};
+use crate::frontend::unit3_observer as journal;
+fn origins(v:&Option<DiagnosticOrigins>,p:&str) {
+    if let Some(v)=v {span(&v.primary,format!("{p}.diagnostic_origins.primary"));span(&v.cause,format!("{p}.diagnostic_origins.cause"));}
+}
+pub(super) fn register(raw:&RawOwnedProgram) {
+    journal::registry_begin();
+    journal::capture("raw-before-audit",raw);
+    for (ri,r) in raw.records.iter().enumerate(){
+        let p=format!("records[{ri}]");declaration(r,p.clone());span(&r.span,format!("{p}.span"));
+        for (fi,f) in r.fields.iter().enumerate(){let p=format!("{p}.fields[{fi}]");declaration(f,p.clone());span(&f.span,format!("{p}.span"));}
+    }
+    for (fi,f) in raw.functions.iter().enumerate(){
+        let p=format!("functions[{fi}]");declaration(f,p.clone());span(&f.span,format!("{p}.span"));
+        for (i,v) in f.locals.iter().enumerate(){span(&v.span,format!("{p}.locals[{i}].span"));}
+        for (i,v) in f.places.iter().enumerate(){span(&v.span,format!("{p}.places[{i}].span"));}
+        for (i,v) in f.owners.iter().enumerate(){span(&v.span,format!("{p}.owners[{i}].span"));}
+        for (i,v) in f.references.iter().enumerate(){span(&v.span,format!("{p}.references[{i}].span"));}
+        for (i,v) in f.calls.iter().enumerate(){span(&v.span,format!("{p}.calls[{i}].span"));}
+        for (i,v) in f.loans.iter().enumerate(){span(&v.span,format!("{p}.loans[{i}].span"));}
+        for (bi,b) in f.blocks.iter().enumerate(){
+            let p=format!("{p}.blocks[{bi}]");span(&b.span,format!("{p}.span"));
+            if let Some(m)=&b.merge {merge(m,&format!("{p}.merge"));}
+            for (si,s) in b.statements.iter().enumerate(){
+                let p=format!("{p}.statements[{si}]");span(&s.span,format!("{p}.span"));origins(&s.diagnostic_origins,&p);
+                match &s.kind {
+                    OwnedInstruction::Scalar(v)=>statement(v,&format!("{p}.kind.scalar")),
+                    OwnedInstruction::Construct{fields,..}=>for (i,(_,v)) in fields.iter().enumerate(){span(&v.span,format!("{p}.kind.fields[{i}].value.span"));},
+                    OwnedInstruction::WriteField{value,..}|OwnedInstruction::PrepareScalar{value,..}=>span(&value.span,format!("{p}.kind.value.span")),
+                    OwnedInstruction::StorageLive(_)|OwnedInstruction::StorageEnd(_)|OwnedInstruction::MoveInitialize{..}|OwnedInstruction::Replace{..}|OwnedInstruction::Discard(_)|OwnedInstruction::ReadField{..}|OwnedInstruction::OpenCall(_)|OwnedInstruction::PrepareOwned{..}|OwnedInstruction::PrepareBorrow{..}=>(),
+                }
+            }
+            if let Some(t)=&b.terminator {
+                let p=format!("{p}.terminator");span(&t.span,format!("{p}.span"));origins(&t.diagnostic_origins,&p);
+                match &t.kind {
+                    OwnedTerminatorKind::Branch{condition,..}=>span(&condition.span,format!("{p}.kind.condition.span")),
+                    OwnedTerminatorKind::ReturnScalar(v)=>span(&v.span,format!("{p}.kind.value.span")),
+                    OwnedTerminatorKind::Goto(_)|OwnedTerminatorKind::Invoke{..}|OwnedTerminatorKind::ReturnOwned(_)=>(),
+                }
+            }
+        }
+    }
+}
