+//! Independent raw-field address registry, deliberately separate from audit walk.
+use super::*;
+use crate::frontend::unit3_observer as journal;
+pub(super) fn span(value:&Span,path:String) {journal::register("span",value,path);}
+pub(super) fn declaration<T>(value:&T,path:String) {journal::register("declaration",value,path);}
+pub(super) fn merge(value:&BoolMerge,p:&str) {
+    span(&value.span,format!("{p}.span"));span(&value.operator_span,format!("{p}.operator_span"));
+    for (i,v) in value.incoming.iter().enumerate(){span(&v.value.span,format!("{p}.incoming[{i}].value.span"));}
+}
+pub(super) fn statement(value:&Statement,p:&str) {
+    match value {
+        Statement::Assign(v)=>{
+            span(&v.span,format!("{p}.span"));let p=format!("{p}.value");
+            match &v.value {
+                Rvalue::Load(v)=>span(&v.span,format!("{p}.place.span")),
+                Rvalue::Copy(v)=>span(&v.span,format!("{p}.operand.span")),
+                Rvalue::NotBool{operand,operator_span}=>{
+                    span(&operand.span,format!("{p}.operand.span"));span(operator_span,format!("{p}.operator_span"));
+                }
+                Rvalue::CompareScalar{left,right,operator_span,..}|Rvalue::CheckedI32{left,right,operator_span,..}=>{
+                    span(&left.span,format!("{p}.left.span"));span(&right.span,format!("{p}.right.span"));span(operator_span,format!("{p}.operator_span"));
+                }
+                Rvalue::Bool(_)|Rvalue::I32(_)|Rvalue::Unit=>(),
+            }
+        }
+        Statement::Initialize{span:s,place,value}=>{
+            span(s,format!("{p}.span"));span(&place.span,format!("{p}.place.span"));span(&value.span,format!("{p}.value.span"));
+        }
+        Statement::Store{span:s,operator_span,place,value}=>{
+            span(s,format!("{p}.span"));span(operator_span,format!("{p}.operator_span"));span(&place.span,format!("{p}.place.span"));span(&value.span,format!("{p}.value.span"));
+        }
+    }
+}
+pub(super) fn register(raw:&Program) {
+    journal::registry_begin();
+    journal::capture("raw-before-audit",raw);
+    for (fi,f) in raw.functions.iter().enumerate(){
+        let p=format!("functions[{fi}]");declaration(f,p.clone());span(&f.span,format!("{p}.span"));
+        for (i,v) in f.locals.iter().enumerate(){span(&v.span,format!("{p}.locals[{i}].span"));}
+        for (i,v) in f.places.iter().enumerate(){span(&v.span,format!("{p}.places[{i}].span"));}
+        for (bi,b) in f.blocks.iter().enumerate(){
+            let p=format!("{p}.blocks[{bi}]");span(&b.span,format!("{p}.span"));
+            if let Some(m)=&b.merge {merge(m,&format!("{p}.merge"));}
+            for (si,s) in b.statements.iter().enumerate(){statement(s,&format!("{p}.statements[{si}]"));}
+            if let Some(t)=&b.terminator {
+                let p=format!("{p}.terminator");span(&t.span,format!("{p}.span"));
+                match &t.kind {
+                    TerminatorKind::Branch{condition,..}=>span(&condition.span,format!("{p}.kind.condition.span")),
+                    TerminatorKind::Call{args,..}=>for (i,a) in args.iter().enumerate(){span(&a.span,format!("{p}.kind.args[{i}].span"));},
+                    TerminatorKind::Return(v)=>span(&v.span,format!("{p}.kind.value.span")),
+                    TerminatorKind::Goto{..}=>(),
+                }
+            }
+        }
+    }
+}
