+//! Independent test-only passive journal. No expected-data input exists.
+use super::{declaration_index, oir, project};
+use super::source::Span;
+use std::{cell::RefCell, collections::BTreeMap, fmt::{Debug, Write}, path::PathBuf};
+const MAX_ROWS: usize = 250_000;
+const MAX_JOURNAL_BYTES: usize = 64 * 1024 * 1024;
+const MAX_ARTIFACT_BYTES: usize = 64 * 1024 * 1024;
+const MAX_OUTPUT_BYTES: usize = 256 * 1024 * 1024;
+struct Capped { text:String, limit:usize }
+impl Write for Capped {
+    fn write_str(&mut self,s:&str)->std::fmt::Result {
+        if self.text.len().checked_add(s.len()).is_none_or(|n|n>self.limit){return Err(std::fmt::Error);}
+        self.text.push_str(s);Ok(())
+    }
+}
+fn debug(value:&impl Debug,pretty:bool)->String {
+    let mut out=Capped{text:String::new(),limit:MAX_ARTIFACT_BYTES};
+    let result=if pretty {write!(&mut out,"{value:#?}")}else{write!(&mut out,"{value:?}")};
+    assert!(result.is_ok(),"OBSERVATION_LIMIT: debug artifact bytes");out.text
+}
+
+#[derive(Debug)]
+pub(super) struct Visit {
+    pass: &'static str,
+    kind: &'static str,
+    path: Option<String>,
+    span: Option<Span>,
+    succeeded: bool,
+}
+#[derive(Debug, Clone)]
+pub(super) struct Context {
+    route: &'static str,
+    function: usize,
+    activation: Option<u64>,
+    block: Option<usize>,
+    position: String,
+    operation: String,
+}
+#[derive(Debug)]
+pub(super) struct Row { kind: &'static str, context: Option<Context>, payload: String }
+#[derive(Default)]
+struct Journal {
+    enabled: bool,
+    output: PathBuf,
+    addresses: BTreeMap<(&'static str, usize), String>,
+    visits: Vec<Visit>,
+    rows: Vec<Row>,
+    context: Option<Context>,
+    fuel: Option<usize>,
+    journal_bytes: usize,
+    output_bytes: usize,
+}
+thread_local! { static JOURNAL: RefCell<Journal> = RefCell::new(Journal::default()); }
+pub(super) fn capture(name: &str, value: &impl Debug) {
+    if JOURNAL.with_borrow(|j|j.enabled) { output(&format!("{name}.debug"),&debug(value,true)); }
+}
+fn output(name:&str,text:&str) {
+    JOURNAL.with_borrow_mut(|j| {
+        assert!(text.len()<=MAX_ARTIFACT_BYTES,"OBSERVATION_LIMIT: artifact bytes");
+        j.output_bytes=j.output_bytes.checked_add(text.len()).expect("OBSERVATION_LIMIT: output arithmetic");
+        assert!(j.output_bytes<=MAX_OUTPUT_BYTES,"OBSERVATION_LIMIT: aggregate output bytes");
+        std::fs::write(j.output.join(name),text).unwrap();
+    });
+}
+fn reserve(j:&mut Journal,bytes:usize,rows:usize) {
+    assert!(rows<MAX_ROWS,"OBSERVATION_LIMIT: journal rows");
+    j.journal_bytes=j.journal_bytes.checked_add(bytes).expect("OBSERVATION_LIMIT: journal arithmetic");
+    assert!(j.journal_bytes<=MAX_JOURNAL_BYTES,"OBSERVATION_LIMIT: journal bytes");
+}
+pub(super) fn register<T>(kind: &'static str, value: &T, path: String) {
+    JOURNAL.with_borrow_mut(|j| if j.enabled {
+        let key=(kind,std::ptr::from_ref(value) as usize);
+        reserve(j,path.len()+64,j.addresses.len());
+        assert!(j.addresses.insert(key,path).is_none(),"duplicate observer address");
+    });
+}
+pub(super) fn registry_begin() {
+    JOURNAL.with_borrow_mut(|j| { j.addresses.clear(); });
+}
+pub(super) fn visit<T>(kind: &'static str, value: &T, span: Option<Span>, validate: bool, succeeded: bool) {
+    JOURNAL.with_borrow_mut(|j| if j.enabled {
+        let path=j.addresses.get(&(kind,std::ptr::from_ref(value) as usize)).cloned();
+        reserve(j,path.as_ref().map_or(0,String::len)+128,j.visits.len());
+        j.visits.push(Visit{pass:if validate {"validate"} else {"count"},kind,path,span,succeeded});
+    });
+}
+pub(super) fn context(route: &'static str,function:usize,activation:Option<u64>,block:Option<usize>,position:impl Into<String>, operation:&impl Debug) {
+    JOURNAL.with_borrow_mut(|j| if j.enabled {
+        let position=position.into();let operation=debug(operation,false);
+        reserve(j,position.len()+operation.len()+128,j.rows.len());
+        j.context=Some(Context{route,function,activation,block,position,operation});
+        j.rows.push(Row{kind:"operation_start",context:j.context.clone(),payload:"()".into()});
+    });
+}
+pub(super) fn event(kind: &'static str, value: &impl Debug) {
+    JOURNAL.with_borrow_mut(|j| if j.enabled {
+        let payload=debug(value,false);
+        let context_bytes=j.context.as_ref().map_or(0,|c|c.operation.len()+c.position.len()+128);
+        reserve(j,payload.len()+context_bytes+128,j.rows.len());
+        j.rows.push(Row{kind,context:j.context.clone(),payload});
+    });
+}
+pub(super) fn fuel(default:usize)->usize { JOURNAL.with_borrow(|j| if j.enabled {j.fuel.unwrap_or(default).min(default)}else{default}) }
+pub(super) fn charge(cost:usize,available:usize,origin:Span) {
+    event("charge_attempt",&(cost,available,origin,available.checked_sub(cost).is_some()));
+}
+fn begin_run(fuel:Option<usize>) {
+    JOURNAL.with_borrow_mut(|j| {j.rows.clear();j.context=None;j.fuel=fuel;j.journal_bytes=0;j.addresses.clear();j.visits.clear();});
+}
+fn write_trace(name:&str) {
+    let text=JOURNAL.with_borrow(|j|debug(&j.rows,true));output(&format!("{name}.trace.debug"),&text);
+}
+fn marker(name:&str,nonce:&str,request:&str,stage:&str) {
+    output(name,&format!("{{\"nonce\":\"{nonce}\",\"source_request_sha256\":\"{request}\",\"stage\":\"{stage}\"}}"));
+}
+#[test]
+#[ignore = "source-only observer request via explicit environment"]
+fn observe_request() {
+    let entry=std::env::var("OXID_UNIT3_ENTRY").expect("source entry");
+    let output_dir=PathBuf::from(std::env::var("OXID_UNIT3_OUTPUT").expect("output directory"));
+    assert!(output_dir.is_dir());
+    JOURNAL.with_borrow_mut(|j| *j=Journal{enabled:true,output:output_dir.clone(),..Journal::default()});
+    let nonce=std::env::var("OXID_UNIT3_NONCE").expect("request nonce");
+    let request=std::env::var("OXID_UNIT3_REQUEST_SHA256").expect("source request identity");
+    assert!([&nonce,&request].iter().all(|s|s.len()==64 && s.bytes().all(|b|b.is_ascii_hexdigit())),"request identity encoding");
+    marker("started.json",&nonce,&request,"started");
+    let mode=std::env::var("OXID_UNIT3_MODE").expect("source mode");
+    let operations=std::env::var("OXID_UNIT3_OPERATIONS").expect("operation subset");
+    let operations:Vec<_>=operations.split(',').collect();
+    assert!(!operations.is_empty() && operations.iter().all(|v|matches!(*v,"check"|"run"|"native")),"unknown operation");
+    let loaded=match mode.as_str() {
+        "private-project-candidate" => project::ProjectSources::load_project_candidate(&entry,project::ProjectLimits::default()),
+        "original-single-file" => project::ProjectSources::load_original(&entry,project::ProjectLimits::default()),
+        _=>panic!("unknown source mode"),
+    };
+    let loaded=match loaded {
+        Ok(loaded)=>loaded,
+        Err(failure)=>{
+            capture("load-failure",&failure);
+            output("diagnostics.jsonl",&failure.diagnostics.iter().map(|d|d.render_json(&failure.sources)).collect::<Vec<_>>().join("\n"));
+            marker("completion.json",&nonce,&request,"load-denied");
+            return;
+        }
+    };
+    capture("loaded",&loaded);
+    let checked={
+        let work=declaration_index::WorkMeter::default();
+        let mut allocator=project::budget::Allocator::default();
+        let result=oir::project::check_project_executable_candidate(&loaded,declaration_index::IndexLimits::default(),&work,&mut allocator);
+        capture("namespace-work",&work);
+        result
+    };
+    let visits=JOURNAL.with_borrow(|j|debug(&j.visits,true));output("audit-visits.debug",&visits);
+    let checked=match checked {
+        Ok(checked)=>checked,
+        Err(errors)=>{
+            capture("check-failure",&errors);
+            output("diagnostics.jsonl",&errors.iter().map(|d|d.render_json(loaded.sources())).collect::<Vec<_>>().join("\n"));
+            marker("completion.json",&nonce,&request,"check-denied");
+            return;
+        }
+    };
+    capture("checked",&checked);
+    let budgets=std::env::var("OXID_UNIT3_FUEL").unwrap_or_default();
+    let mut runs=vec![None];
+    runs.extend(budgets.split(',').filter(|v|!v.is_empty()).map(|v|Some(v.parse::<usize>().expect("fuel integer"))));
+    for fuel in runs.iter().copied().filter(|_|operations.contains(&"run")) {
+        begin_run(fuel);
+        let name=fuel.map_or_else(||"reference-default".to_string(),|n|format!("reference-fuel-{n}"));
+        // Always enter the original wrapper and preserve entry-before-plan order.
+        let result=checked.run();
+        capture(&name,&result);
+        let outcome=match result {
+            Ok(value)=>format!("{{\"result\":{}}}",value.json()),
+            Err(diagnostic)=>diagnostic.render_json(loaded.sources()),
+        };
+        output(&format!("{name}.json"),&outcome);
+        write_trace(&name);
+    }
+    if operations.contains(&"native") {
+      for fuel in runs {
+        begin_run(fuel);
+        let name=fuel.map_or_else(||"native-default".to_string(),|n|format!("native-fuel-{n}"));
+        match checked.native_module() {
+            Ok(module)=>output(&format!("{name}.ll"),&module),
+            Err(diagnostic)=>output(&format!("{name}.diagnostic.json"),&diagnostic.render_json(loaded.sources())),
+        }
+      }
+    }
+    capture("checked-after-consumers",&checked);
+    marker("completion.json",&nonce,&request,"checked");
+    JOURNAL.with_borrow_mut(|j| {j.enabled=false;j.fuel=None;});
+}
