+fn generic_probe(raw: &RawOwnedProgram, sources: &SourceMap) {
+    let cloned = RawOwnedProgram {
+        records: raw
+            .records
+            .iter()
+            .map(|r| RawRecordDecl {
+                id: r.id,
+                span: r.span,
+                fields: r.fields.clone(),
+            })
+            .collect(),
+        functions: raw.functions.clone(),
+    };
+    // The controller hashes these independent structural serializations. This
+    // witness/result is never returned to source construction or either consumer.
+    crate::frontend::unit3_observer::capture("generic-probe-input-original", raw);
+    crate::frontend::unit3_observer::capture("generic-probe-input-clone", &cloned);
+    let result = super::super::verified::verify_owned(cloned, sources);
+    match result {
+        Ok(_witness) => crate::frontend::unit3_observer::capture(
+            "generic-probe-result",
+            &"accepted-and-discarded",
+        ),
+        Err(error) => crate::frontend::unit3_observer::capture("generic-probe-result", &error),
+    }
+}
+fn cleanup(raw: &mut RawOwnedProgram, owner: SourceOwner<'_>, id: &str, kind: &str) {
+    let edge = if id.contains("continue") || id == "correspondence-reverse-cleanup" {
+        "continue"
+    } else if id.contains("break") {
+        "break"
+    } else if id.contains("join") && !id.contains("return") {
+        "join"
+    } else {
+        "return"
+    };
+    let mut selected = Vec::new();
+    for (fi, f) in raw.functions.iter().enumerate() {
+        for (bi, b) in f.blocks.iter().enumerate() {
+            let Some(t) = &b.terminator else { continue };
+            let text = owner.text(t.span).unwrap().trim();
+            let edge_matches = match edge {
+                "continue" => text.starts_with("continue"),
+                "break" => text.starts_with("break"),
+                "return" => text.starts_with("return"),
+                "join" => text == "}",
+                _ => false,
+            };
+            if !edge_matches {
+                continue;
+            }
+            let ends: Vec<_> = b
+                .statements
+                .iter()
+                .enumerate()
+                .filter_map(|(si, s)| match s.kind {
+                    OwnedInstruction::StorageEnd(o)
+                        if matches!(f.owners[o.0].kind, OwnerKind::Local { .. })
+                            && s.span == t.span =>
+                    {
+                        Some((si, o))
+                    }
+                    _ => None,
+                })
+                .collect();
+            if !ends.is_empty() {
+                selected.push((fi, bi, ends));
+            }
+        }
+    }
+    // Global source/CFG order defines the first lexical cleanup edge; no trial
+    // verification or result-based search may choose another site.
+    assert!(
+        !selected.is_empty(),
+        "MUTATION_SELECTION: cleanup anchor absent"
+    );
+    let (fi, bi, ends) = selected.remove(0);
+    let b = &mut raw.functions[fi].blocks[bi];
+    let (si, _) = ends[0];
+    let path = format!("functions[{fi}].blocks[{bi}].statements[{si}]");
+    match kind {
+        "swap-two-independent-StorageEnd" => {
+            assert!(
+                ends.len() >= 2,
+                "MUTATION_SELECTION: two independent cleanup owners required"
+            );
+            let sj = ends[1].0;
+            let before = (b.statements[si].clone(), b.statements[sj].clone());
+            b.statements.swap(si, sj);
+            fault::applied(&path, &before, &(&b.statements[si], &b.statements[sj]));
+        }
+        "duplicate-StorageEnd" => {
+            let before = b.statements[si].clone();
+            b.statements.insert(si, before.clone());
+            fault::applied(&path, &before, &"duplicated once");
+        }
+        "remove-StorageEnd" | "remove-required-StorageEnd" => {
+            let before = b.statements.remove(si);
+            fault::applied(&path, &before, &"removed once");
+        }
+        _ => unreachable!(),
+    }
