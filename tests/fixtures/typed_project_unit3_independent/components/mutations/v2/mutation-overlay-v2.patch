+//! Test-only fault input and exact application journal. No expected outcomes.
+use super::{
+    ast,
+    declaration_index::SourceOwner,
+    hir, lexer, oir,
+    project::{ModuleId, ProjectSources},
+    source::{SourceFileId, SourceMap, SourceView, Span},
+};
+use std::{cell::RefCell, fmt::Debug};
+#[derive(Clone, Debug)]
+pub(super) struct Spec {
+    pub id: String,
+    pub kind: String,
+    pub category: String,
+    pub occurrence: usize,
+}
+#[derive(Default)]
+struct State {
+    applied: usize,
+    seen: usize,
+}
+thread_local! {static STATE:RefCell<State>=RefCell::new(State::default());}
+pub(super) fn reset() {
+    STATE.with_borrow_mut(|s| *s = State::default());
+}
+pub(super) fn spec() -> Option<Spec> {
+    std::env::var("OXID_UNIT3_MUTATION_ID").ok().map(|id| Spec {
+        id,
+        kind: std::env::var("OXID_UNIT3_MUTATION_KIND").expect("mutation kind"),
+        category: std::env::var("OXID_UNIT3_MUTATION_CATEGORY").unwrap_or_default(),
+        occurrence: std::env::var("OXID_UNIT3_MUTATION_OCCURRENCE")
+            .unwrap_or_else(|_| "0".into())
+            .parse()
+            .expect("mutation occurrence"),
+    })
+}
+pub(super) fn applied(path: &str, before: &impl Debug, after: &impl Debug) {
+    STATE.with_borrow_mut(|s| {
+        s.applied += 1;
+        assert_eq!(
+            s.applied, 1,
+            "MUTATION_SELECTION: more than one application"
+        );
+    });
+    super::unit3_observer::capture(
+        "mutation-applied",
+        &(
+            spec().unwrap(),
+            path,
+            format!("{before:?}"),
+            format!("{after:?}"),
+        ),
+    );
+}
+pub(super) fn pending() -> bool {
+    STATE.with_borrow(|s| s.applied == 0)
+}
+pub(super) fn finish() {
+    if spec().is_some() {
+        STATE.with_borrow(|s| assert_eq!(s.applied, 1, "MUTATION_SELECTION: no application"));
+    }
+}
+pub(super) fn map(owner: SourceOwner<'_>) -> &SourceMap {
+    match owner.view() {
+        SourceView::Map(m) => m,
+        SourceView::Single(_) => panic!("MUTATION_SELECTION: map-backed owner required"),
+    }
+}
+pub(super) fn foreign(owner: SourceOwner<'_>, old: Span) -> Span {
+    let map = map(owner);
+    assert!(map.files().len() > 1, "MUTATION_SELECTION: no foreign file");
+    let file = SourceFileId((old.file.0 + 1) % map.files().len());
+    let same = Span { file, ..old };
+    if map.is_valid_span(same) {
+        return same;
+    }
+    let module = owner.module_for_file(file).unwrap();
+    let span = owner
+        .ast(module)
+        .unwrap()
+        .tokens
+        .iter()
+        .find(|t| t.kind == lexer::Kind::Ident)
+        .expect("MUTATION_SELECTION: no checked foreign identifier")
+        .span;
+    assert!(map.is_valid_span(span));
+    span
+}
+pub(super) fn span(category: &str, path: &str, at: &mut Span, owner: SourceOwner<'_>) {
+    let Some(s) = spec() else { return };
+    if s.kind != "replace-span" || s.category != category {
+        return;
+    }
+    let selected = STATE.with_borrow_mut(|state| {
+        let n = state.seen;
+        state.seen += 1;
+        n == s.occurrence
+    });
+    if selected {
+        let before = *at;
+        *at = foreign(owner, before);
+        applied(path, &before, at);
+    }
+}
+pub(super) fn entry(entry: Option<hir::DefId>) -> Option<hir::DefId> {
+    if spec().is_some_and(|s| s.kind == "source-seal-seam-entry") {
+        let changed = Some(hir::DefId(0));
+        assert_ne!(
+            entry, changed,
+            "MUTATION_SELECTION: entry control must differ"
+        );
+        applied("constructor.local.entry", &entry, &changed);
+        changed
+    } else {
+        entry
+    }
+}
+pub(super) fn audit_visit(validate: bool, span: Span) -> u8 {
+    let Some(s) = spec() else { return 0 };
+    if validate
+        && pending()
+        && matches!(
+            s.kind.as_str(),
+            "audit-visitor-suppress-one-visit" | "audit-visitor-repeat-one-visit"
+        )
+    {
+        let n = if s.kind == "audit-visitor-suppress-one-visit" {
+            1
+        } else {
+            2
+        };
+        applied(
+            "validate.Construct.fields[0].value.span",
+            &(span, "once"),
+            &(span, if n == 1 { "omitted" } else { "twice" }),
+        );
+        n
+    } else {
+        0
+    }
+}
+pub(super) fn count_delta() -> bool {
+    spec().is_some_and(|s| s.kind == "audit-count-seam") && pending()
+}
+pub(super) fn count_overflow(validate: bool) -> bool {
+    !validate && spec().is_some_and(|s| s.kind == "audit-count-seam-overflow") && pending()
+}
+
+pub(super) enum Constructor {
+    Map(SourceMap),
+    Ast(ast::Program),
+    Nonzero(SourceMap, ast::Program),
+}
+pub(super) fn constructor(project: &ProjectSources) -> Option<Constructor> {
+    let s = spec()?;
+    if !matches!(
+        s.kind.as_str(),
+        "original-source-constructor-substitution" | "original-source-map-file-id"
+    ) {
+        return None;
+    }
+    let (source, _) = project
+        .original_file()
+        .expect("MUTATION_SELECTION: original source fixture required");
+    let text = source.text();
+    if s.kind == "original-source-map-file-id" {
+        let mut map = SourceMap::new();
+        map.add("mutation-decoy.ox".into(), String::new());
+        let id = map.add(source.path().into(), text.into());
+        assert_eq!(id, SourceFileId(1));
+        let ast = super::parser::parse(map.get(id), lexer::lex(map.get(id)).unwrap()).unwrap();
+        applied("constructor.actual_file", &0usize, &1usize);
+        return Some(Constructor::Nonzero(map, ast));
+    }
+    let mut substitute = SourceMap::new();
+    let (path, bytes) = if s.id.ends_with("same_bytes_new_map") {
+        ("different-allocation.ox".into(), text.into())
+    } else if s.id.ends_with("same_offsets_other_map") {
+        (source.path().into(), " ".repeat(text.len()))
+    } else {
+        (source.path().into(), text.into())
+    };
+    let id = substitute.add(path, bytes);
+    if s.id.ends_with("stale_parser_generation") {
+        let ast = super::parser::parse(substitute.get(id), lexer::lex(substitute.get(id)).unwrap())
+            .unwrap();
+        applied(
+            "constructor.parser_generation",
+            &"actual-source",
+            &"different-source-generation",
+        );
+        Some(Constructor::Ast(ast))
+    } else {
+        applied(
+            "constructor.map",
+            &"actual-map-allocation",
+            &"different-map-allocation",
+        );
+        Some(Constructor::Map(substitute))
+    }
+}
+impl Constructor {
+    pub(super) fn check<'a>(
+        &'a self,
+        p: &'a ProjectSources,
+    ) -> Result<oir::CheckedSourceProgram<'a>, Vec<super::diagnostic::Diagnostic>> {
+        let (source, ast) = p.original_file().unwrap();
+        match self {
+            Self::Map(map) => oir::check_source(source, ast, map),
+            Self::Ast(other) => oir::check_source(source, other, p.sources()),
+            Self::Nonzero(map, ast) => oir::check_source(map.get(SourceFileId(1)), ast, map),
+        }
+    }
+    pub(super) fn sources<'a>(&'a self, p: &'a ProjectSources) -> &'a SourceMap {
+        match self {
+            Self::Map(map) | Self::Nonzero(map, _) => map,
+            Self::Ast(_) => p.sources(),
+        }
+    }
+}
