+        }
+        for (i, v) in f.owners.iter_mut().enumerate() {
+            fault::span(
+                "owned.owners.span",
+                &format!("{p}.owners[{i}].span"),
+                &mut v.span,
+                owner,
+            );
+        }
+        for (i, v) in f.references.iter_mut().enumerate() {
+            fault::span(
+                "owned.references.span",
+                &format!("{p}.references[{i}].span"),
+                &mut v.span,
+                owner,
+            );
+        }
+        for (i, v) in f.calls.iter_mut().enumerate() {
+            fault::span(
+                "owned.calls.span",
+                &format!("{p}.calls[{i}].span"),
+                &mut v.span,
+                owner,
+            );
+        }
+        for (i, v) in f.loans.iter_mut().enumerate() {
+            fault::span(
+                "owned.loans.span",
+                &format!("{p}.loans[{i}].span"),
+                &mut v.span,
+                owner,
