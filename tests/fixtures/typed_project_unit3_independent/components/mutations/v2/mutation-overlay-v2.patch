+//! Test-only mutation of actual scalar raw lowering output.
+use super::*;
+use crate::frontend::{declaration_index::SourceOwner, unit3_mutations as fault};
+pub(super) fn statement(s: &mut Statement, p: &str, owner: SourceOwner<'_>) {
+    let mut visit = |cat: &str, suffix: &str, span: &mut Span| {
+        fault::span(cat, &format!("{p}.{suffix}"), span, owner)
+    };
+    match s {
+        Statement::Assign(a) => {
+            visit("scalar.Statement.Assign.span", "span", &mut a.span);
+            match &mut a.value {
+                Rvalue::Load(x) => visit(
+                    "scalar.Rvalue.Load.place.span",
+                    "value.place.span",
+                    &mut x.span,
+                ),
+                Rvalue::Copy(x) => visit(
+                    "scalar.Rvalue.Copy.operand.span",
+                    "value.operand.span",
+                    &mut x.span,
+                ),
+                Rvalue::NotBool {
+                    operand,
+                    operator_span,
+                } => {
+                    visit(
+                        "scalar.Rvalue.NotBool.operand.span",
+                        "value.operand.span",
+                        &mut operand.span,
+                    );
+                    visit(
+                        "scalar.Rvalue.NotBool.operator_span",
+                        "value.operator_span",
+                        operator_span,
+                    );
+                }
+                Rvalue::CompareScalar {
+                    left,
+                    right,
+                    operator_span,
+                    ..
+                } => {
+                    visit(
+                        "scalar.Rvalue.CompareScalar.left.span",
+                        "value.left.span",
+                        &mut left.span,
+                    );
+                    visit(
+                        "scalar.Rvalue.CompareScalar.right.span",
+                        "value.right.span",
+                        &mut right.span,
+                    );
+                    visit(
+                        "scalar.Rvalue.CompareScalar.operator_span",
+                        "value.operator_span",
+                        operator_span,
+                    );
+                }
+                Rvalue::CheckedI32 {
+                    left,
+                    right,
+                    operator_span,
+                    ..
+                } => {
+                    visit(
+                        "scalar.Rvalue.CheckedI32.left.span",
+                        "value.left.span",
+                        &mut left.span,
+                    );
+                    visit(
+                        "scalar.Rvalue.CheckedI32.right.span",
+                        "value.right.span",
+                        &mut right.span,
+                    );
+                    visit(
+                        "scalar.Rvalue.CheckedI32.operator_span",
+                        "value.operator_span",
+                        operator_span,
+                    );
+                }
+                Rvalue::Bool(_) | Rvalue::I32(_) | Rvalue::Unit => (),
+            }
+        }
+        Statement::Initialize { place, value, span } => {
+            visit("scalar.Statement.Initialize.span", "span", span);
+            visit(
+                "scalar.Statement.Initialize.place.span",
+                "place.span",
+                &mut place.span,
+            );
+            visit(
+                "scalar.Statement.Initialize.value.span",
+                "value.span",
+                &mut value.span,
+            );
+        }
+        Statement::Store {
+            place,
+            value,
+            operator_span,
+            span,
+        } => {
+            visit("scalar.Statement.Store.span", "span", span);
+            visit(
+                "scalar.Statement.Store.operator_span",
+                "operator_span",
+                operator_span,
+            );
+            visit(
+                "scalar.Statement.Store.place.span",
+                "place.span",
+                &mut place.span,
+            );
+            visit(
+                "scalar.Statement.Store.value.span",
+                "value.span",
+                &mut value.span,
+            );
+        }
+    }
+}
+pub(super) fn merge(m: &mut BoolMerge, p: &str, route: &str, owner: SourceOwner<'_>) {
+    fault::span(
+        &format!("{route}.BoolMerge.span"),
+        &format!("{p}.span"),
+        &mut m.span,
+        owner,
+    );
+    fault::span(
+        &format!("{route}.BoolMerge.operator_span"),
+        &format!("{p}.operator_span"),
+        &mut m.operator_span,
+        owner,
+    );
+    for (i, x) in m.incoming.iter_mut().enumerate() {
+        fault::span(
+            &format!("{route}.BoolMerge.incoming[{i}].value.span"),
+            &format!("{p}.incoming[{i}].value.span"),
+            &mut x.value.span,
+            owner,
+        );
+    }
+}
+pub(super) fn apply(raw: &mut Program, owner: SourceOwner<'_>) {
+    let Some(spec) = fault::spec() else { return };
+    if !matches!(
+        spec.kind.as_str(),
+        "replace-span" | "call-target" | "remove-last-call-argument" | "call-result-slot-type"
+    ) {
+        return;
+    }
+    crate::frontend::unit3_observer::capture("mutation-before-raw", raw);
+    if spec.kind == "replace-span" {
+        for (fi, f) in raw.functions.iter_mut().enumerate() {
+            let p = format!("functions[{fi}]");
+            fault::span(
+                "scalar.Function.span",
+                &format!("{p}.span"),
+                &mut f.span,
+                owner,
+            );
+            for (i, v) in f.locals.iter_mut().enumerate() {
+                fault::span(
+                    "scalar.locals.span",
+                    &format!("{p}.locals[{i}].span"),
+                    &mut v.span,
+                    owner,
+                );
+            }
+            for (i, v) in f.places.iter_mut().enumerate() {
+                fault::span(
+                    "scalar.places.span",
+                    &format!("{p}.places[{i}].span"),
+                    &mut v.span,
+                    owner,
+                );
+            }
+            for (bi, b) in f.blocks.iter_mut().enumerate() {
+                let p = format!("{p}.blocks[{bi}]");
+                fault::span(
+                    "scalar.Block.span",
+                    &format!("{p}.span"),
+                    &mut b.span,
+                    owner,
+                );
+                if let Some(m) = &mut b.merge {
+                    merge(m, &format!("{p}.merge"), "scalar", owner);
+                }
