+fn origins(v: &mut Option<DiagnosticOrigins>, p: &str, owner: SourceOwner<'_>) {
+    if let Some(v) = v {
+        fault::span(
+            "owned.DiagnosticOrigins.primary",
+            &format!("{p}.diagnostic_origins.primary"),
+            &mut v.primary,
+            owner,
+        );
+        fault::span(
+            "owned.DiagnosticOrigins.cause",
+            &format!("{p}.diagnostic_origins.cause"),
+            &mut v.cause,
+            owner,
+        );
+    }
