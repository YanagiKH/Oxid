+        for (bi, b) in f.blocks.iter_mut().enumerate() {
+            let p = format!("{p}.blocks[{bi}]");
+            fault::span("owned.Block.span", &format!("{p}.span"), &mut b.span, owner);
+            if let Some(m) = &mut b.merge {
