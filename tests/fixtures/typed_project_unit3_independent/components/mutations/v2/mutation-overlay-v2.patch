+                .map(|(i, _)| i)
+                .collect();
+            assert_eq!(sites.len(), 1);
+            let bi = sites[0];
+            let t = f.blocks[bi].terminator.as_mut().unwrap();
+            let OwnedTerminatorKind::ReturnOwned(at) = &mut t.kind else {
+                unreachable!()
+            };
+            let before = *at;
+            assert_ne!(before, parameter);
+            assert_eq!(f.owners[before.0].record, f.owners[parameter.0].record);
+            *at = parameter;
+            fault::applied(
+                &format!("functions[{fi}].blocks[{bi}].terminator.owner"),
+                &before,
+                at,
+            );
+        }
+        "nested-call-parent" => {
+            'outer: for (fi, f) in raw.functions.iter_mut().enumerate() {
+                for (ci, c) in f.calls.iter_mut().enumerate() {
+                    if let Some((_, arg)) = c.parent {
+                        let before = c.parent;
+                        c.parent = Some((CallSiteId(ci), arg));
+                        fault::applied(
+                            &format!("functions[{fi}].calls[{ci}].parent"),
+                            &before,
+                            &c.parent,
+                        );
+                        break 'outer;
+                    }
+                }
+            }
+        }
+        "remove-outer-PrepareBorrow" => {
+            'outer: for (fi, f) in raw.functions.iter_mut().enumerate() {
+                for (bi, b) in f.blocks.iter_mut().enumerate() {
+                    let selected=b.statements.iter().position(|s|matches!(s.kind,OwnedInstruction::PrepareBorrow{call,..}if f.calls[call.0].parent.is_none()));
+                    if let Some(si) = selected {
+                        let before = b.statements.remove(si);
+                        fault::applied(
+                            &format!("functions[{fi}].blocks[{bi}].statements[{si}]"),
+                            &before,
+                            &"removed, descriptors retained",
+                        );
+                        break 'outer;
+                    }
+                }
+            }
+        }
+        "remove-required-StorageEnd"
+        | "duplicate-StorageEnd"
+        | "remove-StorageEnd"
+        | "swap-two-independent-StorageEnd" => cleanup(raw, owner, &s.id, &s.kind),
+        "replace-diagnostic-origin" => {
+            let sites: Vec<_> = raw
+                .functions
+                .iter()
+                .enumerate()
+                .flat_map(|(fi, f)| {
+                    f.blocks.iter().enumerate().flat_map(move |(bi, b)| {
+                        b.statements
+                            .iter()
+                            .enumerate()
+                            .filter(move |(_, st)| {
+                                matches!(st.kind, OwnedInstruction::ReadField { .. })
+                                    && owner.text(f.span).unwrap() == "main"
+                            })
+                            .map(move |(si, _)| (fi, bi, si))
+                    })
+                })
+                .collect();
+            assert_eq!(
+                sites.len(),
+                1,
+                "MUTATION_SELECTION: failing main ReadField ambiguous"
+            );
+            let (fi, bi, si) = sites[0];
+            let name = raw.functions[fi].span;
+            let meta = raw.functions[fi].blocks[bi].statements[si]
+                .diagnostic_origins
+                .as_mut()
+                .expect("real metadata");
+            let target = if s.id.ends_with("primary") {
+                &mut meta.primary
+            } else {
+                &mut meta.cause
+            };
+            let before = *target;
+            *target = if s.id == "metadata-wrong-file" {
+                fault::foreign(owner, before)
+            } else {
+                name
+            };
+            assert_ne!(before, *target);
+            fault::applied(
+                &format!("functions[{fi}].blocks[{bi}].statements[{si}].diagnostic_origins"),
+                &before,
+                target,
+            );
+        }
+        _ => panic!("MUTATION_SELECTION: unknown owned raw kind {}", s.kind),
+    }
+    fault::finish();
+    crate::frontend::unit3_observer::capture("mutation-after-raw", raw);
+    if s.kind == "replace-diagnostic-origin" {
+        generic_probe(raw, sources);
+    }
+}
