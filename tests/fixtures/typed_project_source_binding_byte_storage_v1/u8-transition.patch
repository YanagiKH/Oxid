+    assert_eq!(run(text), Scalar::I32(255));
+    assert_eq!(run("struct R {} fn main()->i32{let x=127;let mut b=x.to_u8_checked();let a=b;let y=128;b=y.to_u8_checked();return a.to_i32();}"),Scalar::I32(127));
