+        );
+    }
+    let map = source("enum E{V(u8)}");
+    let errors = typed(
+        &map,
+        SourceMode::ProjectCandidate,
+        MAX_NODES,
+        &mut Allocator::default(),
+        &mut SyntaxStorage::default(),
+    )
+    .unwrap_err();
+    assert_eq!((errors[0].code, errors[0].stage), ("E0100", "parse"));
+    assert_eq!(
