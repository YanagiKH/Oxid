+            BorrowedTy::Exact(AggregateTy::FixedArray(array)) => {
+                BorrowedSlotRepr::FixedArray(array)
+            }
+            BorrowedTy::ScalarSlice(element) => BorrowedSlotRepr::ScalarSlice(element),
+        }))
+    }
+    pub(in crate::frontend) fn referent(self) -> BorrowedTy {
+        match self.0 {
