+            .collect::<Vec<_>>()
+            .join(",");
+        let arguments = vec!["&a"; count].join(",");
+        let case = source::checked_arrays(&format!("fn read({parameters})->i32{{return p{}.len();}}fn main()->i32{{let a=[4];return read({arguments});}}", count-1));
+        let observation = run_array_observed(
+            &case.witness,
+            Some(case.entry),
+            &case.sources,
