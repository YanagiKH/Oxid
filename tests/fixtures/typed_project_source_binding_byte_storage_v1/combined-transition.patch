+    let trace: Vec<_> = allocator
+        .trace
+        .iter()
+        .filter(|e| e.kind == "array HIR elements")
+        .collect();
+    assert_eq!(trace.len(), 1);
+    assert_eq!(
+        (trace[0].length, trace[0].element_bytes, trace[0].success),
+        (2, 8, true)
+    );
