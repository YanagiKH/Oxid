+            for &(span, cost) in &charges {
+                if remaining < cost {
+                    error = Some(OwnedRunFailure::Scalar(RunFailure::Fuel(span)));
+                    break;
+                }
+                remaining -= cost;
+                paid.push((span, cost));
+            }
+            assert_eq!(actual.result, error.map_or(Ok(Scalar::I32(-94)), Err));
