+                        selected.frames = 1;
+                        Err(OwnedRunFailure::Scalar(RunFailure::Frames(s(base, 62))))
+                    }
+                    2 => {
+                        selected.slots = 4;
+                        Err(OwnedRunFailure::Scalar(RunFailure::Slots(s(base, 0))))
+                    }
+                    3 => {
+                        selected.cells -= 1;
