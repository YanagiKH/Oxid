+                        .events
+                        .iter()
+                        .filter(|event| matches!(event, Event::Release(..)))
+                        .count(),
+                    3
+                );
+                let writes: Vec<_> = actual
+                    .events
+                    .iter()
+                    .filter_map(|event| match event {
+                        Event::WriteIndex(_, 0, value) => Some(*value),
+                        _ => None,
+                    })
+                    .collect();
+                assert_eq!(
+                    writes,
