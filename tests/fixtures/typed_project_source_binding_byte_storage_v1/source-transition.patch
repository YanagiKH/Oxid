+        Some(hir::DefId(0)),
+        Limits::default(),
+        ObservationControl {
+            poison_destinations: false,
+            fault: Some(execute::FaultInjection { at, kind }),
+            ..ObservationControl::default()
+        },
+    )
+    .unwrap();
+    assert!(!observation.truncated);
+    assert!(observation.fault_applied);
+    observation
