+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+fn check_process(
+    scratch: &Scratch,
+    binary: &std::path::Path,
+    arguments: &[String],
+    expected: Result<Scalar, Failure>,
+    sources: &SourceMap,
+) {
+    match expected {
+        Ok(value) => assert_result(
+            scratch.run(binary, arguments),
+            &scalar_output(value),
+            b"",
+            0,
+        ),
+        Err(error) => assert_result(
+            scratch.run(binary, arguments),
+            b"",
+            error
+                .observed()
+                .diagnostic(sources)
+                .render_human(sources)
+                .as_bytes(),
+            1,
+        ),
+    }
+}
