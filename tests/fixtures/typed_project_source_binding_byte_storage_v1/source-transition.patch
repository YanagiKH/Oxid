+fn reference(kind: BorrowKind, position: usize, span: Span) -> ReferenceDecl {
+    ReferenceDecl {
+        aggregate: AggregateSlot::try_from_aggregate(array(hir::Ty::I32, 2)).unwrap(),
+        kind,
+        position,
+        span,
+    }
+}
