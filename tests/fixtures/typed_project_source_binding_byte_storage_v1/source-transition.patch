+fn configured(
+    raw: RawOwnedProgram,
+    sources: &SourceMap,
+    limits: Limits,
+    control: ObservationControl,
+) -> ReferenceObservation {
+    verified::probe_array_reference(
+        raw,
+        sources,
+        budget::Limits::DEFAULT,
+        Some(hir::DefId(0)),
+        limits,
+        control,
+    )
