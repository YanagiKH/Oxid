+            ast::StmtKind::Let { mutable, .. } => {
+                if mutable {
+                    7
+                } else {
+                    6
+                }
+            }
+            ast::StmtKind::Assign { .. } => 8,
+            ast::StmtKind::Expr(_) => 9,
+            ast::StmtKind::Return(_) => 10,
+            ast::StmtKind::Break => 11,
+            ast::StmtKind::Continue => 12,
+            ast::StmtKind::If { .. } => 13,
+            ast::StmtKind::While { .. } => 14,
+            _ => return Err(Boundary::Frame),
