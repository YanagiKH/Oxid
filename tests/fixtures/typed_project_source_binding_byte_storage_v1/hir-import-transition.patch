+                    require(row.a == 0)?;
+                }
+                self.edge_token(Kind::Return, row.start, NONE)?;
+            }
+            ast::StmtKind::Break | ast::StmtKind::Continue => {
+                require(row.a == 0 && row.b == 0 && row.c == 0)?;
+                self.edge_token(
