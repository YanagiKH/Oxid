+    assert!(matches!(
+        verify_terminal::root_entry(&ast, source, &candidate),
+        Err(Failure::Shape)
+    ));
+    candidate.signatures[1].span = ast.functions[1].name;
+    candidate.signatures.pop();
+    assert!(matches!(
+        verify_terminal::root_entry(&ast, source, &candidate),
+        Err(Failure::Shape)
