+    fn statement(
+        &mut self,
+        function: u8,
+        block: u8,
+        index: u8,
+        reference: u8,
+        depth: u8,
+    ) -> Result<(), Boundary> {
+        let body = &self
+            .program
+            .functions
+            .get(usize::from(function))
+            .and_then(|f| f.blocks.get(usize::from(block)))
+            .ok_or(Boundary::Frame)?
+            .body;
