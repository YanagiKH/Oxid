+    let original = include_str!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/tests/fixtures/checked_hir_import/scalar-boolean-source.txt"
+    ));
+    let fixture = include_bytes!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
