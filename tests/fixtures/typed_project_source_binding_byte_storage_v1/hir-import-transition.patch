+                self.push(Event::Block {
+                    function,
+                    id: small(body.0)?,
+                    row: row.b,
+                    depth: depth + 1,
+                })?;
+                self.expression_event(condition, row.a, false, 0, 1)?;
+                self.edge_token(Kind::While, row.start, NONE)?;
