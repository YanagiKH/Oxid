+#[test]
+fn checked_hir_allocation_admission_prices_canonical_capacity_and_fixed_roles() {
+    let canonical = hir::Program {
+        signatures: Vec::with_capacity(7),
+        functions: Vec::with_capacity(9),
+    };
+    let outside = 137;
+    let mut allocator = Allocator::default();
