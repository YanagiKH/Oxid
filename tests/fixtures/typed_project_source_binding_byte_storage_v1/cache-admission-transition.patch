+// Cache admission assumes a stable filesystem. It does not prevent concurrent
+// replacement or secure arbitrary Git configuration/metadata internals.
+fn cache_directory_exists(path: &Path) -> Result<bool, String> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == io::ErrorKind::NotFound => return Ok(false),
+        Err(error) => {
+            return Err(format!(
+                "cannot inspect dependency cache location {}: {error}",
+                path.display()
+            ))
+        }
+    };
+    #[cfg(windows)]
+    let redirected = {
+        use std::os::windows::fs::MetadataExt;
+        // Reject all reparse points, including junctions, not just symlinks.
+        metadata.file_attributes() & 0x400 != 0
+    };
+    #[cfg(not(windows))]
+    let redirected = metadata.file_type().is_symlink();
+    if redirected || !metadata.is_dir() {
+        return Err(format!("dependency cache location must be an ordinary directory without symlink or reparse redirection: {}", path.display()));
+    }
+    Ok(true)
+}
+
+fn admit_git_cache_location(project_root: &Path, name: &str) -> Result<bool, String> {
+    // project_root is already canonical. Inspect each managed component before
+    // touching any descendant; an absent ancestor means an absent checkout.
+    let mut path = project_root.to_path_buf();
+    for component in [".oxid", "deps", name] {
+        path.push(component);
+        if !cache_directory_exists(&path)? {
+            return Ok(false);
+        }
+    }
+    path.push(".git");
+    if !cache_directory_exists(&path)? {
         return Err(format!(
-            "dependency cache is not a Git work tree: {}",
+            "dependency cache location requires its own .git directory: {}",
             path.display()
         ));
     }
+    Ok(true)
+}
+
+fn ensure_git_repository(path: &Path) -> Result<(), String> {
+    for (option, expected) in [
+        ("--show-toplevel", path.to_path_buf()),
+        ("--absolute-git-dir", path.join(".git")),
+        ("--git-common-dir", path.join(".git")),
+    ] {
+        let output = git_output(path, &[OsString::from("rev-parse"), OsString::from(option)])
+            .map_err(|error| {
+                format!(
+                    "invalid dependency cache location {}: {error}",
+                    path.display()
+                )
+            })?;
+        // Remove only the command's line ending: spaces in paths are significant.
+        let reported = output.strip_suffix('\n').unwrap_or(&output);
+        let reported = reported.strip_suffix('\r').unwrap_or(reported);
+        let actual = fs::canonicalize(path.join(reported)).map_err(|error| {
+            format!(
+                "cannot resolve dependency cache location {option} at {}: {error}",
+                path.display()
+            )
+        })?;
+        let expected = fs::canonicalize(&expected).map_err(|error| {
+            format!(
+                "cannot resolve dependency cache location {}: {error}",
+                expected.display()
+            )
+        })?;
+        if actual != expected {
+            return Err(format!(
+                "dependency cache location {option} resolves outside its intended root: {}",
+                path.display()
+            ));
+        }
+    }
     Ok(())
 }
 
